# .env.local — local overrides only
# Real values live in .env (which is gitignored)
#
# ── Auth ──────────────────────────────────────────────────────────────────────
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=<run: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))">
# ADMIN_USERNAME=<your admin username>
# ADMIN_PASSWORD_HASH=<run: node scripts/gen-hash.mjs>
#
# ── n8n reader (server-side only) ─────────────────────────────────────────────
# DASHBOARD_READER_TOKEN=<from n8n credential "Header Auth account 2 - x-dashboard-token">
